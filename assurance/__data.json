g)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">0\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, source.DownloadCalls);\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">}\u003C/span>\u003C/span>\u003C/code>\u003C/pre>",15,{"code":27,"from":28,"compiled":22,"label":29,"html":30,"lines":31},"[Fact]\npublic Task ASavedDocumentOpensOfflineAsAScenario()\n{\n    Document expected = new(\"handbook\", \"Offline-ready field handbook\");\n    FakeDocumentSource source = new(expected);\n    FakeInMemoryDocumentCache cache = new();\n    DocumentReader reader = new(new FakeOfflineConnectivity(), source, cache);\n    DocumentReadResult? result = null;\n\n    return Scenario.Define(\"A returning offline reader opens a saved handbook\")\n        .Given(\"An offline reader with a saved document\", () => cache.Seed(expected))\n        .When(\"The reader opens the handbook\",\n            async token => result = await reader.OpenAsync(\"handbook\", token))\n        .Then(\"The saved document is returned\", () => Assert.Equal(expected, result?.Document))\n        .And(\"The web source is not contacted\", () => Assert.Equal(0, source.DownloadCalls))\n        .VerifyAsync();\n}\n","Ahr.Assurance: the Getting started guide's compiled snippet, first-scenario","With AHR Assurance: a scenario the report can read","\u003Cpre class=\"code\" data-lang=\"csharp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">[\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">Fact\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">]\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> Task\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\"> ASavedDocumentOpensOfflineAsAScenario\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">()\u003C/span>\u003C/sp