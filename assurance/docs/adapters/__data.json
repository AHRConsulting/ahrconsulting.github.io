03Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">0m\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, total))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">VerifyAsync\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">();\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">}\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003C/section>\n\u003Csection class=\"tab-panel\" aria-label=\"xUnit v2\">\n\u003C!-- snippet: xunit-v2-readme -->\n\u003Cpre class=\"code\" data-lang=\"csharp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> sealed\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> class\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> BasketTests\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">ITestOutputHelper\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> output)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">{\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    [\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">Fact\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">]\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">    public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> Task\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\"> AnEmptyBasketCostsNothing\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">()\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    {\u003C/s