{"type":"data","nodes":[{"type":"data","data":[{"docsStarts":1},{"foundation":2,"assurance":3},"/foundation/docs/","/assurance/docs/getting-started/"],"uses":{}},null,{"type":"data","data":[{"docs":1,"source":44},{"nav":2,"slugs":43,"first":6},[3,7,11,15,19,23,27,31,35,39],{"name":4,"href":5,"slug":6},"Getting started","/assurance/docs/getting-started/","getting-started",{"name":8,"href":9,"slug":10},"Scenarios","/assurance/docs/scenarios/","scenarios",{"name":12,"href":13,"slug":14},"Business context","/assurance/docs/business-context/","business-context",{"name":16,"href":17,"slug":18},"Evidence","/assurance/docs/evidence/","evidence",{"name":20,"href":21,"slug":22},"The CLI","/assurance/docs/cli/","cli",{"name":24,"href":25,"slug":26},"Running in CI","/assurance/docs/ci/","ci",{"name":28,"href":29,"slug":30},"Adapters","/assurance/docs/adapters/","adapters",{"name":32,"href":33,"slug":34},"Analyzers","/assurance/docs/analyzers/","analyzers",{"name":36,"href":37,"slug":38},"Privacy","/assurance/docs/privacy/","privacy",{"name":40,"href":41,"slug":42},"Performance","/assurance/docs/performance/","performance",[6,10,14,18,22,26,30,34,38,42],{"repo":45,"version":46},"https://github.com/AHRConsulting/Ahr.Assurance","0.1.0"],"uses":{"params":["product"]}},{"type":"data","data":[{"slug":1,"page":2},"scenarios",{"slug":1,"title":3,"html":4,"headings":5,"source":29},"Scenarios","\u003Ch2 id=\"steps\">Steps\u003C/h2>\n\u003Cul>\n\u003Cli>\u003Cstrong>Order:\u003C/strong> steps go \u003Ccode>Given\u003C/code>, \u003Ccode>When\u003C/code>, then \u003Ccode>Then\u003C/code>. \u003Ccode>And\u003C/code> continues the step before it. \u003Ccode>Given\u003C/code> is optional, and the last step is a check.\u003C/li>\n\u003Cli>\u003Cstrong>Callbacks\u003C/strong> can be synchronous or \u003Ccode>Task\u003C/code>-returning, and can take the run's cancellation token.\u003C/li>\n\u003Cli>\u003Cstrong>Ordinary assertions\u003C/strong> work in every step: xUnit, NUnit, MSTest and TUnit asserts, Shouldly, FluentAssertions and Playwright's \u003Ccode>Expect\u003C/code>.\n\u003Cul>\n\u003Cli>A failed check in \u003Ccode>Then\u003C/code> or \u003Ccode>And\u003C/code> makes that check unsatisfied, and the other checks still run.\u003C/li>\n\u003Cli>A failed assertion in \u003Ccode>Given\u003C/code> or \u003Ccode>When\u003C/code> stops the scenario.\u003C/li>\n\u003Cli>Any other exception is an execution error, and the report names the step that stopped.\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003Cli>\u003Cstrong>Inline scenarios run once.\u003C/strong> Define each one inside its test.\u003C/li>\n\u003C/ul>\n\u003Ch2 id=\"acting-again-after-a-check\">Acting again after a check\u003C/h2>\n\u003Cp>A \u003Ccode>When\u003C/code> after a \u003Ccode>Then\u003C/code> starts the next action:\u003C/p>\n\u003C!-- snippet: workflow -->\n\u003Cpre class=\"code\" data-lang=\"csharp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">return\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Scenario.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Define\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"A basket's total follows what is in it\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Given\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"An empty basket\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, () \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> basket \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> new\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> Basket\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">())\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">When\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"A £7 book is added\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, () \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> basket.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Add\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">7m\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Then\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"The total is £7\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, () \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Assert.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Equal\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">7m\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, basket.Total))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">When\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"The book is removed\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, () \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> basket.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Remove\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">7m\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Then\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"The total is zero\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, () \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Assert.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Equal\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">0m\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, basket.Total))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">VerifyAsync\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">();\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch2 id=\"checking-what-a-when-returned\">Checking what a When returned\u003C/h2>\n\u003Cp>A \u003Ccode>When\u003C/code> that returns a value hands it to the checks that take a parameter of its type, so the scenario needs no local to hold it:\u003C/p>\n\u003C!-- snippet: returned-value -->\n\u003Cpre class=\"code\" data-lang=\"csharp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">return\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Scenario.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Define\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"A connected reader downloads and saves a document\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Given\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"An online reader with an empty cache\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, cache.ClearAsync)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">When\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"The reader opens the handbook\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, token \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> reader.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">OpenAsync\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"handbook\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, token))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Then\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"The expected document is returned\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, (\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">DocumentReadResult\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> result) \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Assert.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Equal\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(expected, result.Document))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">And\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"The downloaded document is saved for later\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">async\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> token \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        Assert.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Equal\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(expected, \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">await\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> cache.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">FindAsync\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"handbook\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, token)))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">And\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"The web source is contacted once\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, () \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Assert.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Equal\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">1\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, source.DownloadCalls))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">VerifyAsync\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">();\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>Capturing the value in a local, as getting started does, works too, and suits a converted test or a value several steps read.\u003C/p>\n\u003Ch2 id=\"checking-an-exception\">Checking an exception\u003C/h2>\n\u003Cp>\u003Ccode>WhenThrows&lt;T&gt;\u003C/code> passes only when its work throws exactly \u003Ccode>T\u003C/code>, and the checks after it take the exception. \u003Ccode>WhenThrowsAny&lt;T&gt;\u003C/code> also accepts a type derived from \u003Ccode>T\u003C/code>.\u003C/p>\n\u003C!-- snippet: exception -->\n\u003Cpre class=\"code\" data-lang=\"csharp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">return\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Scenario.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Define\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"A charge of nothing is refused\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Given\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"A basket\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, () \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> basket \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> new\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> Basket\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">())\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">WhenThrows\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">&#x3C;\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">ArgumentOutOfRangeException\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">>(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"Nothing is charged\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, () \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> basket.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Charge\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">0m\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Then\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"The refusal names the amount\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, (\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">ArgumentOutOfRangeException\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> refusal) \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Assert.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Equal\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"amount\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, refusal.ParamName))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">VerifyAsync\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">();\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch2 id=\"parameterised-tests\">Parameterised tests\u003C/h2>\n\u003Cp>Keep the framework's own parameterised tests: \u003Ccode>[Theory]\u003C/code> with \u003Ccode>[InlineData]\u003C/code> in xUnit, \u003Ccode>[TestCase]\u003C/code> in NUnit, \u003Ccode>[DataRow]\u003C/code> in MSTest or \u003Ccode>[Arguments]\u003C/code> in TUnit. Only the test's body becomes a scenario. Give it the same name for every row, and the report shows the rows as one journey, with a table of examples.\u003C/p>\n\u003C!-- snippet: theory -->\n\u003Cpre class=\"code\" data-lang=\"csharp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">[\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">Theory\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">]\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">[\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">InlineData\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">7\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, \u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">5\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, \u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">12\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">)]\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">[\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">InlineData\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">0\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, \u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">0\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, \u003C/span>\u003Cspan style=\"color:var(--ahr-code-number)\">0\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">)]\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> Task\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\"> ATotalAddsItsLines\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">int\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> first, \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">int\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> second, \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">int\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> total)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">{\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-type)\">    Basket\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> basket \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> new\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">();\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">    return\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Scenario.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Define\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"A basket's total adds its lines\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Given\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">$\"Lines of £\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">{first}\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> and £\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">{second}\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, () \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> { basket.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Add\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(first); basket.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Add\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(second); })\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">When\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"The total is read\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, () \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> basket.Total)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Then\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">$\"It is £\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">{total}\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, (\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">decimal\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> read) \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Assert.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Equal\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(total, read))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">VerifyAsync\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">();\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">}\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch2 id=\"reusable-steps\">Reusable steps\u003C/h2>\n\u003Cp>When tests share steps, write each step once and use it by name. Steps are plain C#: static members of a class, over a context the scenario creates fresh for each run.\u003C/p>\n\u003C!-- snippet: reusable-scenario -->\n\u003Cpre class=\"code\" data-lang=\"csharp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">[\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">Fact\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">]\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> Task\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\"> AReaderOpensASavedDocument\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">() \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    Scenario.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Define\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">&#x3C;\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">ReadingContext\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">>(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"A reader opens a saved document\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Given\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(ReadingSteps.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">ASavedDocument\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"handbook\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">When\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(ReadingSteps.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">TheReaderOpens\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"handbook\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Then\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(ReadingSteps.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">TheDocumentIsShown\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"handbook\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">VerifyAsync\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">();\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>The steps class uses the protected factories of \u003Ccode>ScenarioSteps&lt;TContext&gt;\u003C/code>. A step that differs by a value is a method that builds its own name:\u003C/p>\n\u003C!-- snippet: steps-class -->\n\u003Cpre class=\"code\" data-lang=\"csharp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">internal\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> sealed\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> class\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> ReadingSteps\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> : \u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">ScenarioSteps\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">&#x3C;\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">ReadingContext\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">{\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">    public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> static\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> ScenarioAction\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">&#x3C;\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">ReadingContext\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">> \u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">ASavedDocument\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">string\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> id) \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-function)\">        CreateActionStep\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">$\"'\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">{id}\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">' is saved on the device\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, context \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> context.Cache.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Seed\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">new\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> Document\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(id, \u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"Field handbook\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">)));\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">    public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> static\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> ScenarioAction\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">&#x3C;\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">ReadingContext\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">> \u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">TheReaderOpens\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">string\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> id) \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-function)\">        CreateActionStep\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">$\"The reader opens '\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">{id}\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">'\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">async\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> (context, token) \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">            context.Result \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> await\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> new\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> DocumentReader\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(context.Connectivity, context.Source, context.Cache).\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">OpenAsync\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(id, token));\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">    public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> static\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> ScenarioExpectation\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">&#x3C;\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">ReadingContext\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">> \u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">TheDocumentIsShown\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">string\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> id) \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-function)\">        CreateAssertionStep\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">$\"'\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">{id}\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">' is shown\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, context \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Assert.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Equal\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(id, context.Result\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">?\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">.Document\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">?\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">.Id));\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">}\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Factory\u003C/th>\n\u003Cth>For\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\n\u003Ctr>\n\u003Ctd>\u003Ccode>CreateActionStep\u003C/code>\u003C/td>\n\u003Ctd>Setup or work\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Ccode>CreateAssertionStep\u003C/code>\u003C/td>\n\u003Ctd>Ordinary assertions\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Ccode>CreateExpectationStep\u003C/code>\u003C/td>\n\u003Ctd>An explicit \u003Ccode>ExpectationResult\u003C/code>\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Ccode>CreateThrowsStep&lt;T&gt;\u003C/code>\u003C/td>\n\u003Ctd>Work that should throw \u003Ccode>T\u003C/code>\u003C/td>\n\u003C/tr>\n\u003C/tbody>\n\u003C/table>\u003C/div>\n\u003Cp>The context is an ordinary class holding what the steps share:\u003C/p>\n\u003C!-- snippet: reading-context -->\n\u003Cpre class=\"code\" data-lang=\"csharp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">internal\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> sealed\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> class\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> ReadingContext\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> : \u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">IDevice\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">{\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">    public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> IConnectivity\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Connectivity { \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">get\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">; \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">set\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">; } \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> new\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> FakeOnlineConnectivity\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">();\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">    public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> FakeInMemoryDocumentCache\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Cache { \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">get\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">; } \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> new\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">();\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">    public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> FakeDocumentSource\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Source { \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">get\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">; } \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> new\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">new\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> Document\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"handbook\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, \u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"Field handbook\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">));\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">    public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> DocumentReadResult\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">? Result { \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">get\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">; \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">set\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">; }\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">}\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch3 id=\"steps-shared-across-features\">Steps shared across features\u003C/h3>\n\u003Cp>Some steps cut across features, such as taking the device offline. Write them once for an interface:\u003C/p>\n\u003C!-- snippet: shared-steps -->\n\u003Cpre class=\"code\" data-lang=\"csharp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> interface\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> IDevice\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">{\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-type)\">    IConnectivity\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> Connectivity { \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">get\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">; \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">set\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">; }\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">}\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">internal\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> sealed\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> class\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> DeviceSteps\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> : \u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">ScenarioSteps\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">&#x3C;\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">IDevice\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">{\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">    public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> static\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> ScenarioAction\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">&#x3C;\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">IDevice\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">> TheDeviceIsOffline { \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">get\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">; } \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-function)\">        CreateActionStep\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"The device is offline\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, device \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> device.Connectivity \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> new\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> FakeOfflineConnectivity\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">());\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">    public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> static\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> ScenarioAction\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">&#x3C;\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">IDevice\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">> TheDeviceIsOnline { \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">get\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">; } \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-function)\">        CreateActionStep\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"The device is online\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">, device \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\"> device.Connectivity \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=\u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\"> new\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> FakeOnlineConnectivity\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">());\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">}\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>Any scenario whose context implements the interface can use them alongside its own steps, as \u003Ccode>ReadingContext\u003C/code> does above:\u003C/p>\n\u003C!-- snippet: shared-scenario -->\n\u003Cpre class=\"code\" data-lang=\"csharp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">[\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">Fact\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">]\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-keyword)\">public\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\"> Task\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\"> AnOfflineReaderOpensASavedDocument\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">() \u003C/span>\u003Cspan style=\"color:var(--ahr-code-keyword)\">=>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">    Scenario.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Define\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">&#x3C;\u003C/span>\u003Cspan style=\"color:var(--ahr-code-type)\">ReadingContext\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">>(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"An offline reader opens a saved document\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Given\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(DeviceSteps.TheDeviceIsOffline)\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">And\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(ReadingSteps.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">ASavedDocument\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"handbook\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">When\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(ReadingSteps.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">TheReaderOpens\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"handbook\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">Then\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(ReadingSteps.\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">TheDocumentIsShown\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">(\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\">\"handbook\"\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">))\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-fg)\">        .\u003C/span>\u003Cspan style=\"color:var(--ahr-code-function)\">VerifyAsync\u003C/span>\u003Cspan style=\"color:var(--ahr-code-fg)\">();\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>A scenario whose context doesn't implement the interface doesn't compile.\u003C/p>\n\u003Cp>The \u003Ca href=\"/assurance/docs/analyzers/\">analyzers\u003C/a> report common mistakes as you type, such as a scenario that is never verified.\u003C/p>\n",[6,10,13,16,19,22,25],{"id":7,"text":8,"level":9},"steps","Steps",2,{"id":11,"text":12,"level":9},"acting-again-after-a-check","Acting again after a check",{"id":14,"text":15,"level":9},"checking-what-a-when-returned","Checking what a When returned",{"id":17,"text":18,"level":9},"checking-an-exception","Checking an exception",{"id":20,"text":21,"level":9},"parameterised-tests","Parameterised tests",{"id":23,"text":24,"level":9},"reusable-steps","Reusable steps",{"id":26,"text":27,"level":28},"steps-shared-across-features","Steps shared across features",3,"docs/scenarios.md"],"uses":{"params":["page","product"]}}]}
