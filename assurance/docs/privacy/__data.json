{"type":"data","nodes":[{"type":"data","data":[{"docsStarts":1},{"foundation":2,"assurance":3},"/foundation/docs/","/assurance/docs/getting-started/"],"uses":{}},null,{"type":"data","data":[{"docs":1,"source":44},{"nav":2,"slugs":43,"first":6},[3,7,11,15,19,23,27,31,35,39],{"name":4,"href":5,"slug":6},"Getting started","/assurance/docs/getting-started/","getting-started",{"name":8,"href":9,"slug":10},"Scenarios","/assurance/docs/scenarios/","scenarios",{"name":12,"href":13,"slug":14},"Business context","/assurance/docs/business-context/","business-context",{"name":16,"href":17,"slug":18},"Evidence","/assurance/docs/evidence/","evidence",{"name":20,"href":21,"slug":22},"The CLI","/assurance/docs/cli/","cli",{"name":24,"href":25,"slug":26},"Running in CI","/assurance/docs/ci/","ci",{"name":28,"href":29,"slug":30},"Adapters","/assurance/docs/adapters/","adapters",{"name":32,"href":33,"slug":34},"Analyzers","/assurance/docs/analyzers/","analyzers",{"name":36,"href":37,"slug":38},"Privacy","/assurance/docs/privacy/","privacy",{"name":40,"href":41,"slug":42},"Performance","/assurance/docs/performance/","performance",[6,10,14,18,22,26,30,34,38,42],{"repo":45,"version":46},"https://github.com/AHRConsulting/Ahr.Assurance","0.1.0"],"uses":{"params":["product"]}},{"type":"data","data":[{"slug":1,"page":2},"privacy",{"slug":1,"title":3,"html":4,"headings":5,"source":6},"Privacy","\u003Cp>AHR Assurance records what your tests tell it to, like any test output. It collects, holds and sends nothing: there is no telemetry, no upload and no account. Evidence and reports are files in your run folders, and where they go from there is up to you.\u003C/p>\n\u003Cp>They contain what your tests already produce: scenario and step names, assertion messages, expected and actual values, failures from the test platform, and attachments. Keep sensitive data out of them as you would for any test output, and choose who can read the files.\u003C/p>\n",[],"docs/privacy.md"],"uses":{"params":["page","product"]}}]}
