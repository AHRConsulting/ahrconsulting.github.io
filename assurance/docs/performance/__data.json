{"type":"data","nodes":[{"type":"data","data":[{"docsStarts":1},{"foundation":2,"assurance":3},"/foundation/docs/","/assurance/docs/getting-started/"],"uses":{}},null,{"type":"data","data":[{"docs":1,"source":44},{"nav":2,"slugs":43,"first":6},[3,7,11,15,19,23,27,31,35,39],{"name":4,"href":5,"slug":6},"Getting started","/assurance/docs/getting-started/","getting-started",{"name":8,"href":9,"slug":10},"Scenarios","/assurance/docs/scenarios/","scenarios",{"name":12,"href":13,"slug":14},"Business context","/assurance/docs/business-context/","business-context",{"name":16,"href":17,"slug":18},"Evidence","/assurance/docs/evidence/","evidence",{"name":20,"href":21,"slug":22},"The CLI","/assurance/docs/cli/","cli",{"name":24,"href":25,"slug":26},"Running in CI","/assurance/docs/ci/","ci",{"name":28,"href":29,"slug":30},"Adapters","/assurance/docs/adapters/","adapters",{"name":32,"href":33,"slug":34},"Analyzers","/assurance/docs/analyzers/","analyzers",{"name":36,"href":37,"slug":38},"Privacy","/assurance/docs/privacy/","privacy",{"name":40,"href":41,"slug":42},"Performance","/assurance/docs/performance/","performance",[6,10,14,18,22,26,30,34,38,42],{"repo":45,"version":46},"https://github.com/AHRConsulting/Ahr.Assurance","0.1.0"],"uses":{"params":["product"]}},{"type":"data","data":[{"slug":1,"page":2},"performance",{"slug":1,"title":3,"html":4,"headings":5,"source":13},"Performance","\u003Cp>The CLI is published with Native AOT, so \u003Ccode>dotnet assurance report\u003C/code> starts at once and needs no .NET runtime warm-up.\u003C/p>\n\u003Ch2 id=\"try-it-on-this-repository\">Try it on this repository\u003C/h2>\n\u003Cp>This repository's own tests are scenarios, so it makes a ready example. Clone it and run its tests:\u003C/p>\n\u003Cpre class=\"code\" data-lang=\"bash\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-function)\">git\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> clone\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> https://github.com/AHRConsulting/Ahr.Assurance\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-function)\">cd\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> Ahr.Assurance\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-function)\">dotnet\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> test\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> --solution\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> Ahr.Assurance.slnx\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> -c\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> Release\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>Then report the whole solution with the CLI:\u003C/p>\n\u003Cpre class=\"code\" data-lang=\"bash\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-function)\">dotnet\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> tool\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> install\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> Ahr.Assurance.Cli\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-function)\">dotnet\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> assurance\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> report\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> Ahr.Assurance.slnx\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch2 id=\"benchmarks\">Benchmarks\u003C/h2>\n\u003Cp>The benchmark project measures defining and running a scenario, verifying it, writing one evidence file, and rendering a report of one and of 1,000 scenarios:\u003C/p>\n\u003Cpre class=\"code\" data-lang=\"bash\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--ahr-code-function)\">dotnet\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> run\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> -c\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> Release\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> --project\u003C/span>\u003Cspan style=\"color:var(--ahr-code-string)\"> benchmarks/Ahr.Assurance.Benchmarks\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>Results depend on the machine, so compare runs on the same one.\u003C/p>\n",[6,10],{"id":7,"text":8,"level":9},"try-it-on-this-repository","Try it on this repository",2,{"id":11,"text":12,"level":9},"benchmarks","Benchmarks","docs/performance.md"],"uses":{"params":["page","product"]}}]}
